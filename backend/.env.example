# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/municipal_complaints

# Allowed browser origins for CORS (comma-separated)
CLIENT_URL=http://localhost:5173

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1d

# One-time initial admin setup (leave empty to disable)
ADMIN_BOOTSTRAP_KEY=replace-with-a-long-random-string

# Complaint anti-spam (defaults shown)
COMPLAINT_RATE_LIMIT=5
COMPLAINT_RATE_WINDOW_MS=600000
COMPLAINT_DAILY_LIMIT=15
COMPLAINT_DUPLICATE_WINDOW_MS=86400000
