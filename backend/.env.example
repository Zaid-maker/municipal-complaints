# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/municipal_complaints

# Allowed CORS origin (the frontend dev server)
CLIENT_URL=http://localhost:5173

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1d

# One-time initial admin setup (leave empty to disable)
ADMIN_BOOTSTRAP_KEY=replace-with-a-long-random-string
