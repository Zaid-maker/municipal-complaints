# Copy this file to `.env.android` and set your deployed API URL.
#
# Vite bakes these values into the APK's JavaScript bundle, so they are not
# secrets. The real `.env.android` is git-ignored to keep per-deployment
# configuration out of the repository.
VITE_API_URL=https://your-api.onrender.com
VITE_CITIZEN_ONLY=true
